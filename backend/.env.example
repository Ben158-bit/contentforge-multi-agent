# ===== DeepSeek API 配置 =====
# 在 https://platform.deepseek.com 获取 API Key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.7
# 演示模式：设为 true 时不需 API Key，用内置 FakeLLM 跑通完整流水线
FAKE_LLM=false

# ===== 服务配置 =====
# 数据目录（SQLite 数据库存放位置，相对 backend 目录）
DATA_DIR=./data
# CORS 允许的前端来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173

# ===== 编排配置 =====
# 审校-创作 最大迭代轮数
MAX_REVISION_ROUNDS=3
# 每阶段 LLM 调用超时（秒）
LLM_TIMEOUT_SECONDS=120

# ===== 联网搜索（调研增强，可选）=====
# provider: bocha（博查，国内直连，https://open.bochaai.com 获取免费额度）
#         / tavily（https://tavily.com 获取免费额度） / 留空禁用
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
